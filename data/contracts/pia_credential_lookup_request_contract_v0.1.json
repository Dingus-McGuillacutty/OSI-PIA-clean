{
  "contract": {
    "artifact_id": "contract-pia-credential-lookup-json-001",
    "name": "PIA Phase 3B Credential Lookup Machine-Readable Contract",
    "version": "0.1.0",
    "domain": "pia",
    "authority": "working",
    "status": "proposed",
    "lifecycle_state": "formulation",
    "development_state": "in_progress_subject_to_change",
    "participant_data_prohibited": true,
    "phase_3b1_network_access": false,
    "phase_3b1_persistence": "none"
  },
  "request": {
    "allowed_fields": [
      "credential_title",
      "issuer_hint",
      "version_hint",
      "credential_type_hint",
      "jurisdiction_hint",
      "source_scope",
      "purpose"
    ],
    "required_fields": [
      "credential_title",
      "source_scope",
      "purpose"
    ],
    "max_lengths": {
      "credential_title": 240,
      "issuer_hint": 200,
      "version_hint": 200,
      "credential_type_hint": 40,
      "jurisdiction_hint": 100,
      "source_scope": 40,
      "purpose": 80
    },
    "enums": {
      "credential_type_hint": [
        "",
        "certification",
        "license",
        "certificate",
        "course_completion",
        "badge",
        "degree",
        "other"
      ],
      "source_scope": [
        "pia_catalog_only"
      ],
      "purpose": [
        "reference_definition_resolution"
      ]
    },
    "prohibited_field_fragments": [
      "participant",
      "intake_session",
      "credential_holder",
      "credential_evidence",
      "certificate_number",
      "completion_date",
      "application_evidence",
      "work_application",
      "contact",
      "email",
      "document",
      "artifact",
      "storage",
      "private_path",
      "note"
    ]
  },
  "response": {
    "required_fields": [
      "lookup_request_id",
      "request_fingerprint",
      "resolution_status",
      "routing_outcome",
      "credential_definition_id",
      "candidate_credential_family_ids",
      "candidate_credential_definition_ids",
      "participant_clarification_required",
      "clarification_prompt",
      "public_catalog_action",
      "external_lookup_permitted",
      "next_action",
      "participant_claims_established",
      "boundary"
    ],
    "routing_outcomes": [
      "resolved",
      "manual_definition_review",
      "confirm_version",
      "ambiguous_credential",
      "external_registry_lookup",
      "source_access_review",
      "conflict_review"
    ],
    "public_catalog_actions": [
      "none",
      "use_existing_review_queue",
      "propose_participant_free_source_research"
    ],
    "participant_claims_must_equal": []
  }
}
