{
  "contract": {
    "artifact_id": "contract-pia-credential-resolution-linkage-json-001",
    "name": "PIA Credential Resolution Linkage Machine-Readable Contract",
    "version": "0.1.0",
    "domain": "pia",
    "authority": "working",
    "status": "proposed",
    "lifecycle_state": "formulation",
    "development_state": "in_progress_subject_to_change"
  },
  "private_session_record": {
    "storage": "encrypted_participant_session_only",
    "required_fields": [
      "credential_entry_id",
      "descriptor",
      "local_lookup",
      "external_lookup",
      "clarification_history",
      "created_at",
      "updated_at"
    ],
    "deletion_scope": "participant_session",
    "withdrawal_effect": "block_new_resolution_and_clarification"
  },
  "minimization_gate": {
    "construction": "new_allowlisted_object",
    "prohibited_strategy": "serialize_participant_record_then_remove_fields",
    "public_request_contract": "contract-pia-credential-lookup-json-001",
    "participant_identity_prohibited": true,
    "session_identity_prohibited": true,
    "completion_evidence_prohibited": true,
    "application_evidence_prohibited": true
  },
  "external_connector": {
    "optional": true,
    "catalog_first_required": true,
    "server_side_only": true,
    "approved_endpoint_required": true,
    "api_key_storage": "environment_only",
    "browser_key_exposure_prohibited": true,
    "maximum_results": 10,
    "candidate_acceptance": "phase_3a_required",
    "automatic_catalog_mutation": false,
    "participant_claims_must_equal": []
  },
  "clarification": {
    "allowed_fields": [
      "credential_title",
      "issuer_hint",
      "version_hint"
    ],
    "one_bounded_response_at_a_time": true,
    "stored_private": true,
    "rerun_minimization_gate": true,
    "issuer_verification_effect": "none"
  },
  "operational_states": [
    "resolved",
    "manual_definition_review",
    "confirm_version",
    "ambiguous_credential",
    "external_registry_lookup",
    "source_access_review",
    "conflict_review"
  ]
}
